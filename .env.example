# Copie este arquivo para .env na raiz do projeto e ajuste os valores.
# O arquivo .env está no .gitignore e nunca deve ser enviado ao GitHub.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oficina
DB_PASSWORD=senha_do_banco
